{"id": "p_order_basic", "note": "Textbook order with a redundant pronoun", "transcript": [{"role": "npc", "npc_id": "maria", "text": "¿Qué te doy, joven?"}, {"role": "learner", "npc_id": "maria", "text": "Yo quiero un café de olla por favor"}, {"role": "npc", "npc_id": "maria", "text": "Claro que sí, ahorita te lo traigo."}, {"role": "event", "npc_id": "maria", "text": "serve_order items=cafe_olla total_mxn=50"}], "expected": ["order"]}
