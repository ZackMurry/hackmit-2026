{"id": "p_full_maria", "note": "Name, order and price in one visit", "transcript": [{"role": "npc", "npc_id": "maria", "text": "¡Buenas tardes! Pásale, joven. ¿Cómo te llamas?"}, {"role": "learner", "npc_id": "maria", "text": "Hola, me llamo Sam"}, {"role": "npc", "npc_id": "maria", "text": "Mucho gusto, Sam. ¿Qué te doy?"}, {"role": "learner", "npc_id": "maria", "text": "Quisiera unos chilaquiles verdes"}, {"role": "npc", "npc_id": "maria", "text": "Muy bien."}, {"role": "event", "npc_id": "maria", "text": "serve_order items=chilaquiles total_mxn=120"}, {"role": "learner", "npc_id": "maria", "text": "¿Cuánto es?"}, {"role": "npc", "npc_id": "maria", "text": "Son ciento veinte pesos."}], "expected": ["introduce", "order", "ask_price"]}
{"id": "p_small_talk", "note": "Three exchanges with full clauses about themselves", "transcript": [{"role": "npc", "npc_id": "luis", "text": "¡Hola! Siéntate. Oye, ¿y de dónde eres?"}, {"role": "learner", "npc_id": "luis", "text": "Soy de Seattle"}, {"role": "npc", "npc_id": "luis", "text": "¡Qué padre! ¿Y a qué te dedicas?"}, {"role": "learner", "npc_id": "luis", "text": "Trabajo en un hospital, soy enfermera"}, {"role": "npc", "npc_id": "luis", "text": "Qué bonito trabajo. ¿Y qué te gusta hacer aquí?"}, {"role": "learner", "npc_id": "luis", "text": "Me gusta mucho la playa y nadar en el mar"}, {"role": "npc", "npc_id": "luis", "text": "A mí también."}], "expected": ["hometown", "small_talk"]}
