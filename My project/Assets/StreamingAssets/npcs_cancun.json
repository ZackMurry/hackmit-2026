          "path": [
            { "x": 2.7, "y": -1.5, "z": 2.0 },
            { "x": 2.7, "y": -1.5, "z": 6.8 },
            { "x": 3.7, "y": -1.5, "z": 8.4 },
            { "x": 3.9, "y": -1.5, "z": 9.8 }
